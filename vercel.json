{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/site.js": {
      "includeFiles": "index.html",
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex,nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex,nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site"
    },
    {
      "source": "/index.html",
      "destination": "/api/site"
    },
    {
      "source": "/index-project-spacing.html",
      "destination": "/api/site"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/site"
    },
    {
      "source": "/((?!admin\\.html$|robots\\.txt$|api/).*)",
      "destination": "/api/site"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin.html",
      "permanent": false
    }
  ]
}
