{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node --test tests/ssr.test.cjs",
  "outputDirectory": ".",
  "functions": {
    "api/site.js": {
      "includeFiles": "index.html",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/admin/?",
      "status": 307,
      "headers": {
        "Location": "/admin.html",
        "X-Robots-Tag": "noindex,nofollow"
      }
    },
    {
      "src": "/admin\\.html",
      "dest": "/admin.html",
      "headers": {
        "X-Robots-Tag": "noindex,nofollow"
      }
    },
    {
      "src": "/robots\\.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/.*",
      "dest": "/api/site"
    }
  ]
}
